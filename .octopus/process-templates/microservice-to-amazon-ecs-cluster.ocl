name = "Microservice to Amazon ECS Cluster"
description = <<-EOT
        ## Standard Microservice template
        
        This process template captures the standard microservice deployment including database changes and service deployment to Amazon ECS. 
        EOT

icon {
    color = "#1A77CA"
    id = "dharmachakra"
}

parameter "Infrastructure.Target.Tag" {
    display_settings = {
        Octopus.ControlType = "TargetTags"
    }
    help_text = ""
    label = "ECS Cluster Target Tag"
}

parameter "Infrastructure.WorkerPool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = "Worker Pool"
}

parameter "Project.Database.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Database Name"
}

parameter "Project.Database.Server" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Data Server"
}

parameter "Project.Database.UserName" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Database User Name"
}

parameter "Project.Database.UserPass" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Database User Password"
}

parameter "Template.ECS.Task.Cpu" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "ECS Task CPU"
}

parameter "Template.ECS.Task.Memory" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "ECS Task Memory"
}

parameter "Template.ECS.Task.ExecRole.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "ECS Task Exec Role Name"
}

parameter "Template.ECS.Task.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "ECS Task Name"
}

parameter "Template.Container.Id" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Container ID to run in ECS"
}

parameter "Template.Container.Name" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "Container Name (friendly) to run in ECS"
}

parameter "Template.AWS.SecurityGroup.Id" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "AWS Security Group Id"
}

parameter "Template.AWS.Subnet.Id" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    label = "AWS Subnet.Id"
}

step "run-database-migration" {
    name = "Run database migration"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "echo 'Deploying database changes ...'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "Bash"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "#{Infrastructure.WorkerPool}"
    }
}

step "deploy-microservice" {
    name = "Deploy Microservice"
    properties = {
        Octopus.Action.TargetRoles = "#{Infrastructure.Target.Tag}"
    }

    action {
        action_type = "Octopus.AwsDeployEcsService"
        properties = {
            Octopus.Action.Aws.Ecs.Deploy.AutoAssignPublicIp = "True"
            Octopus.Action.Aws.Ecs.Deploy.Containers = "[]"
            Octopus.Action.Aws.Ecs.Deploy.Cpu = "#{Template.ECS.Task.Cpu}"
            Octopus.Action.Aws.Ecs.Deploy.DesiredCount = "1"
            Octopus.Action.Aws.Ecs.Deploy.EnableEcsManagedTags = "False"
            Octopus.Action.Aws.Ecs.Deploy.LoadBalancerMappings = "[]"
            Octopus.Action.Aws.Ecs.Deploy.MaximumHealthPercent = "200"
            Octopus.Action.Aws.Ecs.Deploy.Memory = "#{Template.ECS.Task.Memory}"
            Octopus.Action.Aws.Ecs.Deploy.MinimumHealthPercent = "100"
            Octopus.Action.Aws.Ecs.Deploy.RuntimeArchitecturePlatform = "X86_64"
            Octopus.Action.Aws.Ecs.Deploy.SecurityGroupIds = "[\"#{Template.AWS.SecurityGroup.Id}\"]"
            Octopus.Action.Aws.Ecs.Deploy.ServiceTaskName = "#{Template.ECS.Task.Name}"
            Octopus.Action.Aws.Ecs.Deploy.SubnetIds = "[\"#{Template.AWS.Subnet.Id}\"]"
            Octopus.Action.Aws.Ecs.Deploy.TaskExecutionRole = "#{Template.ECS.Task.ExecRole.Name}"
            Octopus.Action.Aws.Ecs.Deploy.Volumes = "[]"
            Octopus.Action.Aws.Ecs.Tags = "[]"
            Octopus.Action.Aws.Ecs.WaitOption = "{\"Type\":\"WaitWithTimeout\",\"TimeoutMinutes\":\"30\"}"
        }
        worker_pool_variable = "#{Infrastructure.WorkerPool}"
    }
}

step "run-selenium-test-suite" {
    name = "Run Selenium Test Suite"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = "Write-Host 'Hello world'"
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
            OctopusUseBundledTooling = "False"
        }
        worker_pool_variable = "#{Infrastructure.WorkerPool}"
    }
}