name = "Argo CD Application"
description = "## Standard Argo CD Container Deployment"

icon {
    color = "#C45317"
    id = "octopus-deploy"
}

parameter "Template.WorkerPool" {
    display_settings = {
        Octopus.ControlType = "WorkerPool"
    }
    help_text = ""
    label = "Worker Pool"
}

parameter "Template.ContainerRegistry" {
    display_settings = {
        Octopus.ControlType = "Package"
    }
    help_text = ""
    label = "Container Registry"
}

parameter "Template.HelmImageTagPath" {
    display_settings = {
        Octopus.ControlType = "SingleLineText"
    }
    help_text = ""
    is_optional = true
    label = "Helm Image Tag Path"
}

step "update-database" {
    name = "Update Database"

    action {
        action_type = "Octopus.Script"
        properties = {
            Octopus.Action.RunOnServer = "true"
            Octopus.Action.Script.ScriptBody = <<-EOT
                Write-Host "Updating database ..."
                
                # todo: run sql client or migrations framework
                EOT
            Octopus.Action.Script.ScriptSource = "Inline"
            Octopus.Action.Script.Syntax = "PowerShell"
        }
        worker_pool_variable = "#{Template.WorkerPool}"
    }
}

step "update-argo-cd-application-image-tags" {
    name = "Update Argo CD Application Image Tags"

    action {
        action_type = "Octopus.ArgoCDUpdateImageTags"
        properties = {
            Octopus.Action.ArgoCD.CommitMessageSummary = "Octopus Deploy updated image versions"
            Octopus.Action.ArgoCD.CommitMethod = "DirectCommit"
            Octopus.Action.ArgoCD.PushRetryAttempts = "2"
            Octopus.Action.ArgoCD.StepVerification.Method = "ArgoCDApplicationHealthy"
            Octopus.Action.ArgoCD.StepVerification.Timeout = "180"
            Octopus.Action.ArgoCD.Sync.Mode = "AllEnvironments"
        }
        worker_pool_variable = "#{Template.WorkerPool}"

        packages "Template.ContainerRegistry" {
            acquisition_location = "NotAcquired"
            feed = "octopus-server-built-in"
            package_id = ""
            properties = {
                Extract = "false"
                HelmReplacementPath = "#{Template.HelmImageTagPath}"
                PackageParameterName = "Template.ContainerRegistry"
                Purpose = "DockerImageReference"
                SelectionMode = "deferred"
            }
        }
    }
}